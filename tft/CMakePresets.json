{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "tft (ESP32, ESP-IDF)",
      "description": "autofrontcam tft - ESP32 + 2.8\" SPI-Display ILI9341 (4MB, kein PSRAM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{IDF_PATH}/tools/cmake/toolchain-esp32.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "IDF_TARGET": "esp32",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
      },
      "vendor": {
        "espressif": {
          "settings": {
            "compileArgs": [],
            "ninjaArgs": [],
            "flashBaudRate": "460800",
            "monitorBaudRate": "115200"
          }
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Build (tft)"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
